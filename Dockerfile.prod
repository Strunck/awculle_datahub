FROM golang:1.24.7-alpine AS builder

WORKDIR /src

RUN apk add --no-cache ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=production
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$(go env GOARCH) \
    go build -trimpath -ldflags="-s -w -X main.Version=${VERSION}" -o /out/datahub ./main.go

FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

ENV KO_DATA_PATH=/app/kodata

COPY --from=builder /out/datahub /app/datahub
COPY --from=builder /src/kodata /app/kodata

EXPOSE 1881

ENTRYPOINT ["/app/datahub"]