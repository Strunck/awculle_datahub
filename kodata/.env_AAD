# Klarname des Kunden, wird bei Node-Red und im Frontend angezeigt
NAME=Testschrank

# Eingabe des PC Names, wie er im lokalen Netzwerk gefunden werden kann
# Linux: hostname -a
PC_NAME=DOX-VM-ALMA9

# Will be used in metrics an reports - 3 stelliges Kundenkürzel benutzen
UVHOST=AAE

# FTP Password des FTP Servers auf dem ex710
SPS_FTP_PASS=admin

# Admin Passwort für ex710
SPS_PASS=1Online+580

# IP Adresse der Regelung
SPS_IPADRESS=10.90.7.197

# OPCUA Port. Falls dieser Parameter nicht angegeben wird, macht das nichts. Es wird dann der Standard Port 4840 verwendet.
SPS_OPC_PORT=4840

# Momentan keine Funktion, aber schonmal mit reingenommen
SPS_HOSTNAME=AAE-UV4

# OPCUA Url, Achtung Namensauflösung klappt meißtens nicht, daher IP Adresse verwenden
SPS_OPC_ENDPOINT=opc.tcp://aad-onc.uv4.sw:4840

# Bot Name
TELGRAMM_NAME=UV4_AAB
# API Key from Telegram's Botfather
TELGRAMM_API=5831851390:AAEmetv3Y2z0ArPxoFQG3SgfY-XiDbdC_sw
# ChatId, add @ROSE to Group and send /id to get the chatID. Without ChatId, flow Backend will not forward an Alarm
TELGRAMM_CHATID=-733314470

# Do not change this!!!!
NODE_RED_CREDENTIAL_SECRET=thisIsAuniversiallyUsedSecret2secureNode-Red


