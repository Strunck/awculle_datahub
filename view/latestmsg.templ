package view

import "strunck/uv4-middleware/globals"

type LatestNatsMessage struct {
    Subject string
    Data    string
}

templ LatestNatsMessages(messages []LatestNatsMessage ) {
    <div id=nats-latest-string >        
        <code>
            for _, msg := range messages {
             
                    <strong>{ msg.Subject }</strong>: { msg.Data } <br>
             
            }
        </code>
    </div>
   
}


templ AlarmList(al map[string]globals.ActiveAlarm) {
    <div id=alarm-list >
        <code>
            for _, alarm := range al {
             
                    <strong>{ alarm.Alarm.Key }</strong>: { alarm.Text } #{ alarm.Alarm.Ort } <br>
             
            }
        </code>
    </div>
   
}
